# NeuraEvo backend environment.
#
# Copy to `.env` and adjust. Every key below maps 1:1 to a field on
# `app/core/config.py::Settings` (case-insensitive). Values shown commented are
# the built-in defaults — uncomment only to override. Uncommented keys are the
# ones a real deployment must set.
#
# Security fail-fast: outside ENVIRONMENT=development the app refuses to start
# while JWT_SECRET_KEY is the dev default or CORS_ORIGINS contains "*".

# --- Application ------------------------------------------------------------
# PROJECT_NAME=NeuraEvo
# API_VERSION=1.0.0
# One of: development | staging | production. Non-development enables the
# production security gates (explicit CORS, secure JWT secret, HSTS).
ENVIRONMENT=development
# DEBUG=false
# API_V1_PREFIX=/api/v1

# --- Logging ----------------------------------------------------------------
# LOG_LEVEL=INFO

# --- Database ---------------------------------------------------------------
# PostgreSQL connection URL. Required for a live backend.
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/neuraevo
# Connection-pool sizing (PostgreSQL only; SQLite ignores these). Defaults match
# SQLAlchemy's own; POOL_RECYCLE refreshes idle connections so a cloud Postgres
# never hands back a server-dropped one (-1 disables).
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT_SECONDS=30
# DB_POOL_RECYCLE_SECONDS=1800

# --- Authentication / JWT ---------------------------------------------------
# MUST be overridden outside development (the app refuses to boot otherwise).
JWT_SECRET_KEY=change-me-to-a-long-random-secret
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_DAYS=7
# Clock-skew tolerance (seconds) for exp/iat validation.
# JWT_LEEWAY_SECONDS=30

# --- Security headers / transport -------------------------------------------
# SECURITY_HEADERS_ENABLED=true
# SECURITY_CSP=default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'
# SECURITY_REFERRER_POLICY=no-referrer
# SECURITY_PERMISSIONS_POLICY=geolocation=(), microphone=(), camera=(), usb=(), payment=()
# HSTS is emitted only in production over HTTPS.
# HSTS_MAX_AGE_SECONDS=63072000
# HSTS_INCLUDE_SUBDOMAINS=true

# --- Request limits ---------------------------------------------------------
# Reject request bodies larger than this (bytes) with 413. Default 2 MB.
# MAX_REQUEST_BODY_BYTES=2097152

# --- AI endpoint rate limiting ----------------------------------------------
# Per-user cap on expensive AI/generation endpoints.
# AI_RATE_LIMIT_ENABLED=true
# AI_RATE_LIMIT_ATTEMPTS=60
# AI_RATE_LIMIT_WINDOW_SECONDS=60

# --- Email verification / password reset ------------------------------------
# EMAIL_VERIFICATION_CODE_TTL_MINUTES=15
# PASSWORD_RESET_TOKEN_TTL_MINUTES=60

# --- Auth rate limiting -----------------------------------------------------
# Fixed-window limits for sensitive auth endpoints (in-process by default).
# AUTH_RATE_LIMIT_ENABLED=true
# LOGIN_RATE_LIMIT_ATTEMPTS=10
# LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
# EMAIL_SEND_RATE_LIMIT_ATTEMPTS=5
# EMAIL_SEND_RATE_LIMIT_WINDOW_SECONDS=3600
# VERIFY_RATE_LIMIT_ATTEMPTS=10
# VERIFY_RATE_LIMIT_WINDOW_SECONDS=900

# --- Email delivery (account email: verification, password reset) -----------
# EMAIL_PROVIDER: "console" logs rendered mail (dev, no SMTP); "smtp" delivers.
# EMAIL_PROVIDER=console
# EMAIL_FROM_ADDRESS=no-reply@neuraevo.dev
# EMAIL_FROM_NAME=NeuraEvo
# Public frontend base URL used to build links in emails.
# FRONTEND_BASE_URL=http://localhost:3000
# SMTP is only used when EMAIL_PROVIDER=smtp.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true
# SMTP_TIMEOUT_SECONDS=10.0

# --- AI / Anthropic (Claude) ------------------------------------------------
# Required for AI generation features. Never hardcode credentials.
ANTHROPIC_API_KEY=your-anthropic-api-key
# ANTHROPIC_MODEL=claude-sonnet-4-6
# ANTHROPIC_TIMEOUT_SECONDS=30.0
# ANTHROPIC_MAX_TOKENS=4096

# --- Memory -----------------------------------------------------------------
# Max memories selected for context assembly (newest first).
# MEMORY_CONTEXT_LIMIT=10

# --- Vector store / Qdrant --------------------------------------------------
# All optional — the app boots without a configured/live Qdrant.
# QDRANT_URL=
# QDRANT_API_KEY=
# QDRANT_TIMEOUT_SECONDS=30.0

# --- CORS -------------------------------------------------------------------
# Comma-separated allowed origins. "*" is allowed ONLY in development; a
# non-development environment must list explicit origins or the app won't start.
# CORS_ORIGINS=http://localhost:3000
CORS_ORIGINS=*

# --- Runtime capabilities ---------------------------------------------------
# None of the six runtime capabilities require an env var or credential. The
# Browser capability needs the playwright package plus a Chromium build:
#   python -m playwright install chromium
# Set this only to override where Playwright looks for browsers.
# PLAYWRIGHT_BROWSERS_PATH=
# See docs/deployment.md, and GET /api/v1/health/capabilities to check a host.
