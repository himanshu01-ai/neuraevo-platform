# Database
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/neuraevo

# Authentication
JWT_SECRET_KEY=your-jwt-secret-key

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_TIMEOUT_SECONDS=30
ANTHROPIC_MAX_TOKENS=2048

# Memory
MEMORY_CONTEXT_LIMIT=10

# Runtime capabilities
# None of the six require an environment variable or a credential. The Browser
# capability needs the playwright package plus a Chromium build:
#   python -m playwright install chromium
# Set this only to override where Playwright looks for browsers.
# PLAYWRIGHT_BROWSERS_PATH=
# See docs/deployment.md, and GET /api/v1/health/capabilities to check a host.