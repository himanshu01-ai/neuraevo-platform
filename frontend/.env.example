# NeuraEvo frontend environment (public — inlined into the client bundle).
#
# Copy to `.env.local`. Every key maps to a field validated by `lib/env.ts`
# (Zod). Only NEXT_PUBLIC_* values belong here — never put secrets in this file.

# Base URL of the FastAPI backend, including the /api/v1 prefix.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Per-domain service adapter switches: "backend" (default) talks to FastAPI;
# "mock" restores the Sprint 17 offline adapter for UI-only work without a
# running backend. Each is independent; the choice is app-wide per session.
NEXT_PUBLIC_AUTH_ADAPTER=backend
NEXT_PUBLIC_EMPLOYEES_ADAPTER=backend
NEXT_PUBLIC_WORKFLOWS_ADAPTER=backend
NEXT_PUBLIC_TASKS_ADAPTER=backend
# Task/workflow memory-link surface.
NEXT_PUBLIC_MEMORY_ADAPTER=backend
# Standalone memory workspace (real memories via the Memory Engine).
NEXT_PUBLIC_MEMORY_WORKSPACE_ADAPTER=backend
# Conversation Hub (text and voice turns).
NEXT_PUBLIC_CONVERSATIONS_ADAPTER=backend
# Notification center (participant/share notifications).
NEXT_PUBLIC_COLLABORATION_ADAPTER=backend
